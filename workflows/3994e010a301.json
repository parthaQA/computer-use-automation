{
  "schema_version": "capability.v1",
  "id": "3994e010a301",
  "version": 1,
  "title": "Open base_url. Enter operator id JLEE. Enter password {password}. Click Sign On. Enter member id {member_id}.",
  "inputs": [
    {
      "name": "password",
      "type": "string",
      "required": true,
      "secret": true,
      "description": "Operator password from the environment; not stored in the artifact"
    },
    {
      "name": "member_id",
      "type": "string",
      "required": true,
      "secret": false,
      "description": "Membership number to look up"
    }
  ],
  "outputs": [
    {
      "name": "screen_id",
      "type": "string",
      "required": false,
      "secret": false,
      "description": "MEMSYS screen code at the end"
    }
  ],
  "success": {
    "description": "Sign on and enter member id",
    "checks": [],
    "must_see": [],
    "must_not_see": []
  },
  "steps": [
    {
      "type": "navigate",
      "url": "{base_url}/signon",
      "how": "open this URL"
    },
    {
      "type": "change",
      "selectors": [
        [
          "input[name='OPR'][type='text']"
        ],
        [
          "xpath//html/body/center/table/tbody/tr[2]/td/form/table/tbody/tr[1]/td[2]/input"
        ]
      ],
      "value": "JLEE",
      "how": "form name then xpath"
    },
    {
      "type": "change",
      "selectors": [
        [
          "input[name='PWD'][type='password']"
        ],
        [
          "xpath//html/body/center/table/tbody/tr[2]/td/form/table/tbody/tr[2]/td[2]/input"
        ]
      ],
      "value": "<secret>x_password</secret>",
      "how": "form name then xpath"
    },
    {
      "type": "click",
      "selectors": [
        [
          "input[type='submit'][value='Sign On']"
        ],
        [
          "xpath//html/body/center/table/tbody/tr[2]/td/form/table/tbody/tr[3]/td[2]/input"
        ],
        [
          "text/Sign On"
        ]
      ],
      "assertText": "Sign On",
      "how": "css then xpath then visible text"
    },
    {
      "type": "change",
      "selectors": [
        [
          "input[name='MEMID'][type='text']"
        ],
        [
          "xpath//html/body/center/table/tbody/tr[2]/td/table/tbody/tr/td/form/table/tbody/tr/td[2]/input"
        ]
      ],
      "value": "{member_id}",
      "how": "form name then xpath"
    },
    {
      "type": "click",
      "selectors": [
        [
          "input[type='submit'][value='Search']"
        ],
        [
          "xpath//html/body/center/table/tbody/tr[2]/td/table/tbody/tr/td/form/table/tbody/tr/td[3]/input"
        ],
        [
          "text/Search"
        ]
      ],
      "assertText": "Search",
      "how": "css then xpath then visible text"
    }
  ]
}
