{
  "schema_version": "capability.v1",
  "id": "3fea6845d296",
  "version": 1,
  "title": "open base_url, enter operator id and password, click on sign on button. search member id {member_id} and click on search button. verify the member record.",
  "surface": "web",
  "app": "memsys",
  "vendor": "memsys",
  "inputs": [
    {
      "name": "operator",
      "type": "string",
      "required": false,
      "secret": false,
      "description": "Operator id from MEMSYS_OPERATOR in .env; not taken from the prompt"
    },
    {
      "name": "password",
      "type": "string",
      "required": true,
      "secret": true,
      "description": "Operator password from the environment; not stored in the artifact"
    },
    {
      "name": "member_id",
      "type": "string",
      "required": true,
      "secret": false,
      "description": "Membership number to look up"
    }
  ],
  "outputs": [
    {
      "name": "member_found",
      "type": "string",
      "required": false,
      "secret": false,
      "description": "true if the member record was found"
    },
    {
      "name": "member_name",
      "type": "string",
      "required": false,
      "secret": false,
      "description": "Member name as shown on the page"
    },
    {
      "name": "message",
      "type": "string",
      "required": false,
      "secret": false,
      "description": "Core message when the record was not found or blocked"
    },
    {
      "name": "screen_id",
      "type": "string",
      "required": false,
      "secret": false,
      "description": "MEMSYS screen code at the end"
    }
  ],
  "success": {
    "description": "Capture whether member {member_id} was found",
    "checks": [
      {
        "after": "Click Search",
        "description": "Capture whether the member record was found",
        "must_see": [],
        "must_not_see": [],
        "capture": true
      }
    ],
    "must_see": [],
    "must_not_see": []
  },
  "steps": [
    {
      "type": "navigate",
      "url": "{base_url}/signon",
      "desktop_url": "{app}",
      "how": "open this URL"
    },
    {
      "type": "change",
      "selectors": [
        [
          "input[name='OPR'][type='text']"
        ],
        [
          "xpath//html/body/center/table/tbody/tr[2]/td/form/table/tbody/tr[1]/td[2]/input"
        ],
        [
          "automationId/OPR"
        ]
      ],
      "value": "{operator}",
      "how": "form name then xpath then desktop name"
    },
    {
      "type": "change",
      "selectors": [
        [
          "input[name='PWD'][type='password']"
        ],
        [
          "xpath//html/body/center/table/tbody/tr[2]/td/form/table/tbody/tr[2]/td[2]/input"
        ],
        [
          "automationId/PWD"
        ]
      ],
      "value": "<secret>x_password</secret>",
      "how": "form name then xpath then desktop name"
    },
    {
      "type": "click",
      "selectors": [
        [
          "input[type='submit'][value='Sign On']"
        ],
        [
          "xpath//html/body/center/table/tbody/tr[2]/td/form/table/tbody/tr[3]/td[2]/input"
        ],
        [
          "text/Sign On"
        ],
        [
          "name/Sign On"
        ]
      ],
      "assertText": "Sign On",
      "how": "css then xpath then visible text then desktop name"
    },
    {
      "type": "change",
      "selectors": [
        [
          "input[name='MEMID'][type='text']"
        ],
        [
          "xpath//html/body/center/table/tbody/tr[2]/td/table/tbody/tr/td/form/table/tbody/tr/td[2]/input"
        ],
        [
          "automationId/MEMID"
        ]
      ],
      "value": "{member_id}",
      "how": "form name then xpath then desktop name"
    },
    {
      "type": "click",
      "selectors": [
        [
          "input[type='submit'][value='Search']"
        ],
        [
          "xpath//html/body/center/table/tbody/tr[2]/td/table/tbody/tr/td/form/table/tbody/tr/td[3]/input"
        ],
        [
          "text/Search"
        ],
        [
          "name/Search"
        ]
      ],
      "assertText": "Search",
      "how": "css then xpath then visible text then desktop name"
    }
  ]
}
